<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.alandevise</groupId>
    <artifactId>tsgate-bom</artifactId>
    <version>2.1.3</version>
    <packaging>pom</packaging>
    <name>TsGate BOM</name>
    <description>Dependency management for TsGate modules and their verified client runtime dependencies</description>
    <url>https://github.com/AlanDevise/TsGate</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>AlanDevise</id>
            <name>Alan Zhang</name>
            <email>initiator@alandevise.com</email>
            <url>https://github.com/AlanDevise</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/AlanDevise/TsGate.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/AlanDevise/TsGate.git</developerConnection>
        <url>https://github.com/AlanDevise/TsGate</url>
        <tag>v2.1.3</tag>
    </scm>

    <!-- Standalone on purpose: consumers must not inherit the build's Spring Boot or test baselines. -->
    <properties>
        <tsgate.version>${project.version}</tsgate.version>
        <tsgate.iotdb.version>2.0.11</tsgate.iotdb.version>
        <tsgate.influxdb3-java.version>1.10.0</tsgate.influxdb3-java.version>
        <tsgate.okhttp.version>4.12.0</tsgate.okhttp.version>
        <tsgate.netty.version>4.2.15.Final</tsgate.netty.version>
        <tsgate.grpc.version>1.81.0</tsgate.grpc.version>
        <tsgate.arrow.version>19.0.0</tsgate.arrow.version>
        <tsgate.jackson.version>2.21.4</tsgate.jackson.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-core</artifactId>
                <version>${tsgate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-iotdb</artifactId>
                <version>${tsgate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-influxdb1</artifactId>
                <version>${tsgate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-influxdb3</artifactId>
                <version>${tsgate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-iotdb-spring-boot-starter</artifactId>
                <version>${tsgate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-influxdb1-spring-boot-starter</artifactId>
                <version>${tsgate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-influxdb3-spring-boot-starter</artifactId>
                <version>${tsgate.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-opengemini</artifactId>
                <version>${tsgate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.alandevise</groupId>
                <artifactId>tsgate-opengemini-spring-boot-starter</artifactId>
                <version>${tsgate.version}</version>
            </dependency>

            <!-- The selected IoTDB SDK supplies its matching RPC, TSFile and Thrift dependency family. -->
            <dependency>
                <groupId>org.apache.iotdb</groupId>
                <artifactId>iotdb-session</artifactId>
                <version>${tsgate.iotdb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.influxdb</groupId>
                <artifactId>influxdb3-java</artifactId>
                <version>${tsgate.influxdb3-java.version}</version>
            </dependency>

            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-bom</artifactId>
                <version>${tsgate.okhttp.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${tsgate.netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${tsgate.grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.arrow</groupId>
                <artifactId>arrow-bom</artifactId>
                <version>${tsgate.arrow.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${tsgate.jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <profile>
            <id>central-release</id>
            <properties>
                <central.skipPublishing>true</central.skipPublishing>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-release</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <skipPublishing>${central.skipPublishing}</skipPublishing>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <checksums>all</checksums>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
