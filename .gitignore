# Publish portable test sources; keep local fixtures, credentials and reports private.
.local-test/

# Build output and reports
**/target/
*.log
__pycache__/
*.py[cod]

# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store

# Local configuration and credentials
.env
.env.*
settings.xml
settings.xml.*
/.mvn/*settings*.xml*
*.pem
*.key

# Publish README translations and the portable skill; keep local instructions and reports private.
*.md
!/README.md
!/README.zh-CN.md
!/SKILL.md
